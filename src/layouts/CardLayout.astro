---
// <head>: title, WhatsApp / Facebook preview tags (written at build time, so link previews always show the right names),
// theme fonts + stylesheet, and the browser data for card.js.
import type { Card } from "../lib/event";
import { safeJson } from "../lib/event";
interface Props { card: Card }
const { card } = Astro.props;
const { e, theme, siteUrl, themeAsset, asset, base, clientData, version } = card;
const shareDescription = e.meta.shareDescription ?? e.meta.description;
const ogImage = e.meta.ogImage ? `${siteUrl}event/${e.meta.ogImage}?v=${e.meta.version}` : "";
const ogType = e.meta.ogImage.endsWith(".png") ? "image/png" : "image/jpeg";
---
<!doctype html>
<html lang={e.lang} data-palette={card.palette.id}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{e.meta.title}</title>
    <meta name="description" content={e.meta.description} />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:site_name" content={e.meta.title} />
    <meta property="og:title" content={e.meta.title} />
    <meta property="og:description" content={shareDescription} />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:secure_url" content={ogImage} />
        <meta property="og:image:type" content={ogType} />
        <meta property="og:image:width" content={String(e.meta.ogWidth)} />
        <meta property="og:image:height" content={String(e.meta.ogHeight)} />
        <meta property="og:image:alt" content={e.meta.ogAlt} />
      </>
    )}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={e.meta.title} />
    <meta name="twitter:description" content={shareDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {e.hosting.base !== "/" || e.store.mode === "demo" ? <meta name="robots" content="noindex" /> : null}

    <meta name="theme-color" content={card.palette.themeColor} />
    <link rel="icon" href={themeAsset(`favicon.svg?v=${e.meta.version}`)} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={theme.fonts} />
    {theme.preload.map((path) => <link rel="preload" as="image" href={themeAsset(path)} />)}
    <link rel="stylesheet" href={themeAsset(`${theme.stylesheet}?v=${version}`)} />
    <link rel="stylesheet" href={`${base}core/models.css?v=${version}`} />
    {card.palette.css && <style is:inline id="palette" set:html={card.palette.css}></style>}
    <script is:inline define:vars={{ ids: card.palette.ids }}>
      // ?palette=<id> previews another colour option of this theme (the client's own choice is html[data-palette]).
      try { const want = new URLSearchParams(location.search).get("palette"); if (want && (want === "classic" || ids.includes(want))) document.documentElement.dataset.palette = want; } catch (e) {}
    </script>
    <script is:inline type="application/json" id="warkah-data" set:html={safeJson(clientData)}></script>
  </head>
  <body class={`card-closed ${theme.bodyClass}`}>
    <slot />
    <script is:inline type="module" src={`${base}core/card.js?v=${version}`}></script>
  </body>
</html>
