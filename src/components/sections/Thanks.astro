---
import type { Card } from "../../lib/event";
import FooterCredit from "../ui/FooterCredit.astro";
interface Props { card: Card; attrs: Record<string, string> }
const { card, attrs } = Astro.props;
const { e, asset } = card;
---
<section class="section-card thanks reveal" {...attrs} aria-label="Penghargaan">
  <p class="thanks-poem">
    {e.text.poem.map((line, index) => (<>{line}{index < e.text.poem.length - 1 && <br />}</>))}
  </p>
  <p class="thanks-copy">{e.text.thanks}</p>
  <p class="thanks-insya">InsyaAllah</p>
  <p class="thanks-sign">Terima Kasih</p>
  {e.art?.hashtag
    ? <p class="hashtag is-art" aria-label={e.couple.hashtag}><img src={asset(e.art.hashtag)} alt="" /></p>
    : e.couple.hashtag && <p class="hashtag">{e.couple.hashtag}</p>}
  <FooterCredit card={card} />
</section>
