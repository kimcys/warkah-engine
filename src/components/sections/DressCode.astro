---
import type { Card } from "../../lib/event";
interface Props { card: Card; attrs: Record<string, string> }
const { card, attrs } = Astro.props;
const dress = card.e.dressCode;
const ICONS: Record<string, string> = {
  shirt: '<path d="M18 14 26 10h12l8 4 8 6-5 12-6-3v24H15V29l-6 3-5-12 8-6Z" /><path d="M26 10 32 18 38 10" />',
  dress: '<path d="M24 12h16l6 8h8l-5 10-4-2 3 20H16l3-20-4 2-5-10h8l6-8Z" /><path d="M24 12 32 20 40 12" />'
};
---
{dress && (
  <section class="section-card dresscode reveal" {...attrs} id="dressCode" aria-label="Tema warna majlis">
    <h2>{dress.title}</h2>
    <div class="dresscode-grid">
      {dress.colors.map((color) => (
        <figure class={`dresscode-card dresscode-card-${color.tone}`}>
          <svg class="dresscode-icon" viewBox="0 0 64 64" aria-hidden="true" set:html={ICONS[color.icon]} />
          <figcaption><span class="dresscode-title">{color.label}</span></figcaption>
        </figure>
      ))}
    </div>
    {dress.note && <p class="dresscode-note">{dress.note}</p>}
  </section>
)}
