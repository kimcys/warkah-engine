---
// Ucapan Tetamu: its own page in every theme (the guests' wishes, turning by themselves; the page size is theme.client.wishesPerPage).
import type { Card } from "../../lib/event";
interface Props { card: Card; attrs: Record<string, string> }
const { card, attrs } = Astro.props;
const { t } = card;
---
{card.e.features.wishes && (
  <section class="section-card wishes reveal" {...attrs} id="wishesSection" aria-label={t("Ucapan tetamu")}>
    <h2>{t("Ucapan Tetamu")}</h2>
    <div id="wishList" class="wish-list" aria-live="polite"></div>
  </section>
)}
