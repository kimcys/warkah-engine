---
import type { Card } from "../../lib/event";
interface Props { card: Card; attrs: Record<string, string> }
const { card, attrs } = Astro.props;
const { t } = card;
const { e } = card;   // guest wishes have their own page (Wishes.astro)
---
<section class="section-card rsvp-summary reveal" {...attrs} id="rsvpSummary" aria-label={t("Kehadiran")}>
  <h2>{t("Kehadiran")}</h2>
  <p class="rsvp-summary-count" aria-live="polite"><strong id="rsvpGuestCount">&hellip;</strong> {t("Orang")}</p>
  <p class="rsvp-deadline" set:html={e.text.rsvpDeadlineHtml} />
  <p id="rsvpDone" class="rsvp-done" hidden></p>
  <button id="rsvpOpenButton" class="primary-button" data-panel="rsvpPanel" type="button">{t("Sahkan Kehadiran")}</button>
</section>
