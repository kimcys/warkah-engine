---
// One page per person (groom / bride). The first one also carries id="mempelai".
import type { Card } from "../../lib/event";
interface Props { card: Card; attrs: Record<string, string>; who: "groom" | "bride"; isFirst: boolean }
const { card, attrs, who, isFirst } = Astro.props;
const person = card.e.couple[who];
// Themes with groom/bride scenes name them by role; the scene follows the person actually on this page (couple.first decides who comes first).
const model = card.modelOf(who);
const scene = ["groom", "bride"].includes(attrs["data-scene"]) ? who : attrs["data-scene"];
const role = person.role ?? (who === "groom" ? "Putera kepada" : "Puteri kepada");
---
<section
  class={`section-card mempelai mempelai-${who} reveal${model ? " has-model" : ""}`}
  {...attrs}
  data-scene={scene}
  id={isFirst ? "mempelai" : undefined}
  aria-label={who === "groom" ? "Pengantin lelaki" : "Pengantin perempuan"}
>
  {model && (
    <div class="model-figure" aria-hidden="true">
      <img src={model.src} alt="" width="800" height="1195" loading="lazy" decoding="async" />
    </div>
  )}
  <div class="mempelai-card">
    <p class="mempelai-name">{person.name}</p>
    <p class="mempelai-full">{person.full}</p>
    <p class="mempelai-role">{role}</p>
    <p class="mempelai-parents" set:html={person.parentsHtml} />
  </div>
</section>
