---
// Panel backdrop, photo lightbox and toast.
---
<div id="panelOverlay" class="panel-overlay" hidden></div>
<div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Paparan gambar" hidden>
  <button class="lightbox-close" type="button" aria-label="Tutup">&times;</button>
  <button class="lightbox-nav lightbox-prev" type="button" aria-label="Gambar sebelumnya">
    <svg class="carousel-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 6.5 8.8 12l5.7 5.5" /></svg>
  </button>
  <img class="lightbox-img" alt="" />
  <button class="lightbox-nav lightbox-next" type="button" aria-label="Gambar seterusnya">
    <svg class="carousel-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 6.5 5.7 5.5-5.7 5.5" /></svg>
  </button>
  <p class="lightbox-count" aria-live="polite"></p>
</div>
<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
