---
// Pastel wash behind the pages. Four scenes (the same pastel artwork, tinted and panned differently) cross-fade as the guest
// moves from page to page, plus ambience containers (filled by card.js: sparkles and floating hearts).
---
<div class="background-layer" aria-hidden="true"></div>
<div class="scene-layer scene-bloom" aria-hidden="true"></div>
<div class="scene-layer scene-sky" aria-hidden="true"></div>
<div class="scene-layer scene-butter" aria-hidden="true"></div>
<div class="scene-layer scene-rose" aria-hidden="true"></div>
<div class="soft-glow glow-one" aria-hidden="true"></div>
<div class="soft-glow glow-two" aria-hidden="true"></div>
<div class="fairy-lights" aria-hidden="true"></div>
<div class="petal-field" aria-hidden="true"></div>
