---
import type { Card } from "../../../lib/event";
interface Props { card: Card; attrs: Record<string, string> }
const { card, attrs } = Astro.props;
const { t } = card;
---
<section class="section-card countdown reveal" {...attrs} aria-label={t("Kiraan detik ke majlis")}>
  <div data-countdown>
    <p class="section-kicker">{t("Menghitung hari menuju majlis")}</p>
    <div class="countdown-grid">
      <div><strong id="days">0</strong><span>{t("Hari")}</span></div>
      <div><strong id="hours">0</strong><span>{t("Jam")}</span></div>
      <div><strong id="minutes">0</strong><span>{t("Minit")}</span></div>
      <div><strong id="seconds">0</strong><span>{t("Saat")}</span></div>
    </div>
  </div>
  <p id="countdownOver" class="countdown-over" hidden></p>
</section>
