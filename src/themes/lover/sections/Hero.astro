---
// Lover hero: same lockup as the opening (kicker, names, date, time + venue, hashtag).
import type { Card } from "../../../lib/event";
interface Props { card: Card; attrs: Record<string, string> }
const { card, attrs } = Astro.props;
const { t } = card;
const { e, first, second, date, asset } = card;
const art = e.art;
const city = e.venue.area.split(",")[0].trim();
---
<section class="hero" id="home" {...attrs} aria-label={t("{a} dan {b}, {day} {date}", { a: first.short, b: second.short, day: date.dayName, date: date.long })}>
  <h1 class="sr-only">{first.short} &amp; {second.short} — {date.dayName}, {date.long} — {e.venue.name}, {city}</h1>
  <div class="hero-copy" aria-hidden="true">
    <p class="kicker">{e.text.heroKicker}</p>
    {art?.title
      ? <p class="hero-names is-art"><img src={asset(art.title)} alt="" /></p>
      : <p class="hero-names">{first.short} <span>&amp;</span> {second.short}</p>}
    <p class="hero-date">{date.dotted.replace(/\./g, " | ")}</p>
    <p class="hero-venue">{date.timeRange}<br />{e.venue.name}, {city}</p>
    {art?.hashtag
      ? <p class="cover-hashtag is-art"><img src={asset(art.hashtag)} alt="" /></p>
      : e.couple.hashtag && <p class="cover-hashtag">{e.couple.hashtag}</p>}
  </div>
  <div class="page-hint" aria-hidden="true">
    <svg viewBox="0 0 24 24"><path d="m6.5 14.5 5.5-5.5 5.5 5.5" /></svg>
  </div>
</section>
