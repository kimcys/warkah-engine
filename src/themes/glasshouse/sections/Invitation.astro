---
// Invitation: bismillah, the inviting parents, the invitation wording and both full names.
import type { Card } from "../../../lib/event";
interface Props { card: Card; attrs: Record<string, string> }
const { card, attrs } = Astro.props;
const { t } = card;
const { e, first, second } = card;
const [parentA, parentB] = e.host.parents;
---
<section class="section-card invitation reveal" {...attrs} aria-label={t("Jemputan")}>
  <p class="bismillah" lang="ar" dir="rtl">{e.text.bismillah}</p>
  <p class="salam">{e.text.salam}</p>

  <div class="parents">
    <span>{parentA}</span>
    {parentB && <span class="parents-and">&amp;</span>}
    {parentB && <span>{parentB}</span>}
  </div>

  <p class="invite-copy" set:html={e.text.inviteHtml} />
  <p class="invite-copy honorifics" set:html={e.text.honorificsHtml} />
  <p id="guestLine" class="guest-line" hidden></p>
  <p class="invite-copy">{e.host.inviteRelation}</p>

  <div class="full-names">
    <span>{first.name} {first.full}</span>
    <span class="name-butterfly" aria-hidden="true"></span>
    <span>{second.name} {second.full}</span>
  </div>
</section>
