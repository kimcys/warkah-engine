---
// The card. Which client it shows comes from the EVENT env var (set by `npm run dev|build -- <client>`).
import { loadEvent } from "../lib/event";
import { sectionAttrs } from "../lib/sections";
import CardLayout from "../layouts/CardLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Invitation from "../components/sections/Invitation.astro";
import Mempelai from "../components/sections/Mempelai.astro";
import Details from "../components/sections/Details.astro";
import Programme from "../components/sections/Programme.astro";
import Portraits from "../components/sections/Portraits.astro";
import Gallery from "../components/sections/Gallery.astro";
import Doa from "../components/sections/Doa.astro";
import Rsvp from "../components/sections/Rsvp.astro";
import Thanks from "../components/sections/Thanks.astro";
import Panels from "../components/panels/Panels.astro";
import BottomNav from "../components/ui/BottomNav.astro";
import Overlays from "../components/ui/Overlays.astro";

const card = await loadEvent();
const { e, theme, first, second } = card;
const { Opening, Backdrop } = theme;
const f = e.features;

// Sections switched off by the client's features are skipped.
const enabled: Record<string, boolean> = {
  mempelaiGroom: f.mempelai,
  mempelaiBride: f.mempelai,
  portraits: f.portraits,
  gallery: f.gallery && e.gallery.length > 0,
  doa: f.doa,
  rsvp: f.rsvp,
  dressCode: !!e.dressCode
};
const layouts = theme.sections.filter((s) => enabled[s.id] !== false);

// Mempelai pages follow couple.first (groom-side majlis shows the groom first).
const firstWho = e.couple.first;
const secondWho = firstWho === "groom" ? "bride" : "groom";
---
<CardLayout card={card}>
  <main class="phone-shell" aria-label="Kad jemputan digital">
    <Backdrop />
    <Opening card={card} />

    <article id="card" class="card is-locked" aria-label={`Kad jemputan ${first.short} dan ${second.short}`}>
      {layouts.map((layout) => {
        const attrs = sectionAttrs(layout);
        // A theme can draw a page itself (theme.components); otherwise the shared one is used.
        const Custom = (theme as any).components?.[layout.id];
        if (Custom) return <Custom card={card} attrs={attrs} />;
        switch (layout.id) {
          case "hero": return <Hero card={card} attrs={attrs} />;
          case "invitation": return <Invitation card={card} attrs={attrs} />;
          case "mempelaiGroom": return <Mempelai card={card} attrs={attrs} who={firstWho} isFirst={true} />;
          case "mempelaiBride": return <Mempelai card={card} attrs={attrs} who={secondWho} isFirst={false} />;
          case "details": return <Details card={card} attrs={attrs} />;
          case "programme": return <Programme card={card} attrs={attrs} />;
          case "portraits": return <Portraits card={card} attrs={attrs} />;
          case "gallery": return <Gallery card={card} attrs={attrs} />;
          case "doa": return <Doa card={card} attrs={attrs} />;
          case "rsvp": return <Rsvp card={card} attrs={attrs} />;
          case "thanks": return <Thanks card={card} attrs={attrs} />;
          default: return null;
        }
      })}
      <section class="footer-space" aria-hidden="true"></section>
    </article>

    <div class="page-dots" aria-hidden="true"></div>
    <BottomNav card={card} />
    <Overlays />
    <Panels card={card} />
  </main>
</CardLayout>
