---
// The couple's RSVP dashboard: <site>/admin
// Shared-project cards ask the couple to sign in with Google; only emails listed as owners of the event can read RSVPs.
import { loadEvent, safeJson } from "../lib/event";
const card = await loadEvent();
// Cards built in Warkah Kad keep their guests' answers in Warkah Kad, and the customer reads them in their account there.
if (card.clientData.store.mode === "cloudflare") return Astro.redirect(`https://${card.e.hosting.domain ?? "kad.aimanhakimcy.com"}/app/cards`);
const { e, first, second, date, base, clientData, version, themeAsset } = card;
const city = e.venue.area.split(",")[0].trim();
const adminData = {
  slug: card.slug,
  store: clientData.store,
  features: e.features,
  gifts: Object.fromEntries(e.gifts.items.map((gift) => [gift.id, gift.name]))
};
---
<!doctype html>
<html lang="ms">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>RSVP – {first.short} &amp; {second.short}</title>
    <link rel="icon" href={themeAsset(`favicon.svg?v=${e.meta.version}`)} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@500;600;700;800&display=swap" />
    <style is:global>
      :root {
        --bg1: #f6d36a; --bg2: #e9b93a;
        --accent: #7a1424; --accent-deep: #4a0d17;
        --gold: #c8901a; --gold-soft: #f7e3a1;
        --ink: #4a1f1a; --muted: #6e4a3a; --card: rgba(255,248,227,.88); --line: rgba(168,116,20,.4);
        --font-body: "Nunito", "Segoe UI", system-ui, -apple-system, sans-serif;
      }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; font-family: var(--font-body); color: var(--ink);
        background: linear-gradient(160deg, var(--bg1), var(--bg2)) fixed; }
      main { width: min(100%, 760px); margin: 0 auto; padding: 28px 16px 60px; }
      header { text-align: center; margin-bottom: 20px; }
      header h1 { margin: 0; font: 800 clamp(1.7rem, 6vw, 2.2rem)/1.15 var(--font-body); color: var(--accent); }
      header p { margin: 6px 0 0; font-size: .9rem; font-weight: 600; color: var(--muted); }
      .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 18px; }
      .stat { padding: 14px 8px; border-radius: 16px; background: var(--card); border: 1px solid var(--line); text-align: center; }
      .stat strong { display: block; font: 800 1.9rem/1 var(--font-body); color: var(--accent); }
      .stat span { display: block; margin-top: 6px; font-size: .78rem; font-weight: 600; color: var(--muted); }
      .panel { padding: 16px; border-radius: 20px; background: var(--card); border: 1px solid var(--line); }
      .toolbar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
      .tabs { display: flex; gap: 6px; }
      button, input { font: inherit; }
      .tab, .btn { padding: 9px 14px; border-radius: 999px; border: 1px solid var(--line); background: #fff; color: var(--accent-deep);
        font-size: .86rem; font-weight: 700; cursor: pointer; }
      .tab[aria-selected="true"] { background: var(--accent); color: #fff; border-color: var(--accent); }
      .btn { margin-left: auto; }
      input[type="search"] { flex: 1 1 160px; min-width: 0; padding: 9px 14px; border-radius: 999px; border: 1px solid var(--line); background: #fff; color: var(--ink); }
      ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
      li { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; padding: 12px 14px; border-radius: 14px; background: #fff; border: 1px solid var(--line); }
      li strong { font-size: 1rem; font-weight: 700; }
      li small { color: var(--muted); font-size: .82rem; font-weight: 600; }
      li p { grid-column: 1 / -1; margin: 4px 0 0; font-size: .95rem; line-height: 1.5; overflow-wrap: anywhere; }
      .pill { align-self: center; padding: 4px 10px; border-radius: 999px; font-size: .8rem; font-weight: 700; }
      .pill.yes { background: #e3f1dc; color: #2f5a22; }
      .pill.no { background: #f6e0e0; color: #8a2a2a; }
      .empty, .status { text-align: center; color: var(--muted); font-size: .84rem; padding: 18px 0; }
      .signin { text-align: center; padding: 28px 16px; }
      .signin p { margin: 0 0 14px; color: var(--muted); font-weight: 600; }
      .signin .btn { margin: 0; }
      .who { text-align: center; font-size: .78rem; color: var(--muted); margin: -8px 0 14px; }
      .who button { border: 0; background: none; color: var(--accent); font-weight: 700; cursor: pointer; text-decoration: underline; }
      footer { margin-top: 14px; text-align: center; font-size: .66rem; color: var(--muted); }
      @media (max-width: 480px) { .stats { grid-template-columns: repeat(2, 1fr); } .btn { margin-left: 0; } }
    </style>
    <script is:inline type="application/json" id="warkah-admin" set:html={safeJson(adminData)}></script>
  </head>
  <body>
    <main>
      <header>
        <h1>{first.short} &amp; {second.short}</h1>
        <p>Papan RSVP &middot; {date.dayName}, {date.dotted} &middot; {city}</p>
      </header>

      <section id="signin" class="panel signin" hidden>
        <p>Log masuk dengan akaun Google yang didaftarkan untuk melihat senarai tetamu.</p>
        <button class="btn" id="signinButton" type="button">Log masuk dengan Google</button>
        <p id="signinError" class="status" hidden></p>
      </section>

      <div id="dashboard" hidden>
        <p class="who" id="who" hidden></p>
        <section class="stats" aria-label="Ringkasan">
          <div class="stat"><strong id="sGuests">-</strong><span>Jumlah tetamu hadir</span></div>
          <div class="stat"><strong id="sYes">-</strong><span>RSVP hadir</span></div>
          <div class="stat"><strong id="sNo">-</strong><span>Tidak hadir</span></div>
          <div class="stat"><strong id="sWishes">-</strong><span>Ucapan</span></div>
        </section>

        <section class="panel">
          <div class="toolbar">
            <div class="tabs" role="tablist">
              <button class="tab" role="tab" id="tabRsvp" aria-selected="true">RSVP</button>
              <button class="tab" role="tab" id="tabWishes" aria-selected="false">Ucapan</button>
              {e.features.gifts && <button class="tab" role="tab" id="tabGifts" aria-selected="false">Hadiah</button>}
            </div>
            <input id="q" type="search" placeholder="Cari nama..." aria-label="Cari nama" />
            <button class="btn" id="csv" type="button">Muat turun CSV</button>
          </div>
          <p class="status" id="status">Memuatkan...</p>
          <ul id="list"></ul>
        </section>
      </div>
      <footer>Halaman ini tidak disenaraikan di Google. Kad oleh warkah.</footer>
    </main>
    <script is:inline type="module" src={`${base}core/admin.js?v=${version}`}></script>
  </body>
</html>
