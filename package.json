{
  "name": "warkah-engine",
  "private": true,
  "type": "module",
  "description": "Warkah digital invitation engine: one codebase, one folder per client.",
  "scripts": {
    "new": "node scripts/new.mjs",
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "test": "node scripts/test.mjs",
    "thumbnails": "node scripts/thumbnails.mjs",
    "preview": "node scripts/preview.mjs",
    "previews": "node scripts/previews.mjs",
    "kit": "node scripts/kit.mjs",
    "sample": "node scripts/sample.mjs",
    "i18n": "node scripts/i18n-check.mjs",
    "catalogue": "node scripts/run.mjs build minimal-demo --catalogue",
    "build:all": "node scripts/run.mjs build --all",
    "deploy": "node scripts/deploy.mjs",
    "deploy:rules": "firebase deploy --only firestore",
    "build-job": "node scripts/build-job.mjs",
    "build-server": "node scripts/build-server.mjs",
    "build-server:live": "node --env-file=.build-server.env scripts/build-server.mjs --interval 3000"
  },
  "dependencies": {
    "astro": "^7.4.2"
  },
  "engines": {
    "node": ">=18.20.8"
  }
}
